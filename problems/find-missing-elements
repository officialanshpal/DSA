class Solution:
    def findMissingElements(self, nums: List[int]) -> List[int]:
        # Find the boundaries of the original range
        min_val = min(nums)
        max_val = max(nums)
        
        # Convert list to a set for O(1) lookups
        num_set = set(nums)
        missing_elements = []
        
        # Iterate through the expected range
        for i in range(min_val, max_val + 1):
            if i not in num_set:
                missing_elements.append(i)
                
        return missing_elements
